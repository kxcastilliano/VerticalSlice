  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: "Who are you\u2026?"
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: Pardon?
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: "I mean\u2026 What's your name.."
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: 'And why are you so interested in me? '
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: like wanting to get me a drink.
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: 'Oh? How rude of me for not properly introducing myself. '
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: ' My name is Kalos. A pleasure to meet you. '
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: "You know, I don\u2019t blame you for being so suspicious of me."
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: "there\u2019s a bunch of creeps around these parts."
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: ' a beautiful woman like you can be a walking target. '
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: "But I swear\u2026"
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: "I\u2019m just being kind."
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: "I see\u2026 "
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: "I see\u2026 "
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: "Finally I think our drinks are here. \r"
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: What did you order for me?
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: 'Hm? '
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: "Oh, it's a Cosmopolitan. \r"
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: "I thought you\u2019d like it. It matches your hair.\r\n\r"
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: How strong is it?
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: "you\u2019ll have to see for yourself."
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: A cheers to Ryn.
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: Cheers.
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: fbe0e12a368207d42aadf48040e4ab93, type: 2}
    text: Wow.. this drink is good
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: So Ryn, Remind me, what brings you here?
    expression: {fileID: 0}
  - character: {fileID: 11400000, guid: ceb1a7909d01705478cf655dbaaaee6e, type: 2}
    text: He seem like a nice guy.. Do I trust him enough to share that
    expression: {fileID: 0}
